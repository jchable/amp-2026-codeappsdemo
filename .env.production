# Lu par `npm run build` (donc par `npm run push`) : l'app déployée est connectée à SharePoint.
# Versionné (dépôt de démo), aucun secret. VITE_SP_SITE_URL est indicative (non lue par le code) ; le site réel vient de power.config.json.
VITE_SP_SITE_URL=https://votretenant.sharepoint.com/sites/aMP
VITE_USE_SHAREPOINT=true
