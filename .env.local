# Versionné (dépôt de démo). Aucun secret : les connexions sont gérées par Power Platform.
# Défaut de `npm run dev` : mode mémoire, sans Power Platform.
# Le build (`npm run build`) lit .env.production ; `npm run dev:sharepoint` lit .env.sharepoint.
VITE_SP_SITE_URL=https://votretenant.sharepoint.com/sites/aMP
VITE_USE_SHAREPOINT=true
