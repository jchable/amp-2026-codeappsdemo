# Copiez en .env.local (non commité). Aucun secret ici : les connexions sont gérées par Power Platform.
# Renseignez au besoin l'URL du site SharePoint utilisée pour la génération.
VITE_SP_SITE_URL=https://votretenant.sharepoint.com/sites/aMP
# false = mode mémoire (défaut, sans Power Platform) ; true = SharePoint via npm run power:run.
VITE_USE_SHAREPOINT=false
